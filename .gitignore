# ─────────────────────────────────────────────────────────────
# DocuMind .gitignore
# Keep this file organized: secrets first, then dependencies,
# generated files, local data, OS/IDE noise, and media artifacts.
# ─────────────────────────────────────────────────────────────

# ── Environment variables and secrets ────────────────────────
.env
.env.*

# Secret and credential files
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.keystore
*.jks
credentials.json
service-account*.json
firebase-adminsdk*.json

# ── Node.js / Next.js ────────────────────────────────────────
node_modules/
.next/
out/
dist/
build/
coverage/
.turbo/
.eslintcache
*.tsbuildinfo
next-env.d.ts

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Local Next.js env files (covered by .env.* but kept explicit)
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── Python / FastAPI ─────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
ENV/
*.egg-info/
*.eggs
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.pyright/
.ipynb_checkpoints/

# ── AI / vector database local data ──────────────────────────
chroma_data/
chroma_db/
chroma_db*/
.chroma/
vector_store/
vector_db/
embeddings/

# Uploaded user documents and local media processing
uploads/
media/
data/processed/audio.wav

# ── OS-specific files ────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*~

# ── IDE / editor local files ─────────────────────────────────
.vscode/
.idea/
*.suo
*.user
*.sln.docstates
*.sublime-workspace
*.sublime-project

# ── Temporary / backup files ─────────────────────────────────
*.tmp
*.temp
*.bak
*.swp
*.swo

# ── Deployment / platform local state ────────────────────────
.vercel/

# ── Project-specific generated/large files ───────────────────
services/backend/uploads/
services/backend/models/
services/backend/tmp/
services/backend/1775458116283-base.js
services/backend/1775458116303-base.js
PROJECT_DEEP_DIVE.md

# ── Large media / model artifacts ────────────────────────────
*.mp4
*.wav
*.mdl
